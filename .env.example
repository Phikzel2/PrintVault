# PostgreSQL
POSTGRES_DB=printvault
POSTGRES_USER=printvault
POSTGRES_PASSWORD=change-me-strong-password

# Backend
SECRET_KEY=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# CORS — JSON array of allowed origins; set to your actual frontend URL in production
ALLOWED_ORIGINS=["https://your-domain.com"]

# Import integrations (optional)
# THINGIVERSE_TOKEN=your_app_token_here  # register at https://www.thingiverse.com/developers
# MAKERWORLD_TOKEN=your_bambu_token_here  # value of the `token` cookie on makerworld.com (DevTools → Application → Cookies)
# Printables import works without a token

# Optional tuning
# MAX_FILE_SIZE_MB=500
# JWT_EXPIRE_HOURS=168

# Multi-user features (User Management, public/private model toggle,
# visibility filter). Default is single-user; set to true to enable.
# MULTI_USER_MODE=true

# Which published image tag to run (only used by docker-compose.prod.yml).
# Defaults to latest; pin to a release for reproducibility, e.g. 1.0.0
# PRINTVAULT_TAG=1.0.0
